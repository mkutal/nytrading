# Shared backtest/scanner settings; times always use New York local time.
NEW_YORK_START="10:00"
NEW_YORK_END="13:30"
NEW_YORK_TIMEZONE="America/New_York"
TP_RR="1.7"
SIZING_RISK_PERCENT="1"
INITIAL_EQUITY_USD="100000"
DATA_DIR="/data"

# Required by scanner.py; offline backtest ignores these. Never commit real values.
TWELVE_DATA_API_KEY="YOUR_API_KEY"
DISCORD_WEBHOOK_URL="YOUR_DISCORD_WEBHOOK_URL"

# Optional: true fetches data and logs signals without sending Discord.
SCANNER_DRY_RUN="false"
